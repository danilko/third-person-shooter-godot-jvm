[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="character"
3d_physics/layer_3="pickup"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="vehicle"
3d_physics/layer_6="car_wall"
3d_physics/layer_7="stair_ramp"

[navigation]

3d/warnings/navmesh_edge_merge_errors=false
3d/default_cell_size=0.5
3d/default_cell_height=0.5
3d/default_edge_connection_margin=1.5

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/temporary_memory_buffer_size=128
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=65536

[rendering]

occlusion_culling/use_occlusion_culling=true
