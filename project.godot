; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="semi-open-world-shooter"
run/main_scene="res://src/main/resources/com/openworld/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/main/java/com/openworld/game/EventBus.java"
GameManager="*res://src/main/java/com/openworld/game/GameManager.java"
MissionManager="*res://src/main/java/com/openworld/game/mission/MissionManager.java"
MissionDirector="*res://src/main/java/com/openworld/game/mission/MissionDirector.java"
RaceDirector="*res://src/main/java/com/openworld/game/mission/RaceDirector.java"
ActivityRuntime="*res://src/main/java/com/openworld/game/activity/ActivityRuntime.java"
SaveSystem="*res://src/main/java/com/openworld/game/SaveSystem.java"
NetworkManager="*res://src/main/java/com/openworld/net/NetworkManager.java"
PlayerRegistry="*res://src/main/java/com/openworld/game/PlayerRegistry.java"
SpatialEntityGrid="*res://src/main/java/com/openworld/world/SpatialEntityGrid.java"
FactionManager="*res://src/main/java/com/openworld/character/FactionManager.java"
ZoneManager="*res://src/main/java/com/openworld/world/ZoneManager.java"
StimulusManager="*res://src/main/java/com/openworld/world/StimulusManager.java"
DayNight="*res://src/main/java/com/openworld/world/DayNight.java"
StreetLights="*res://src/main/java/com/openworld/world/StreetLights.java"
RouteRibbon="*res://src/main/java/com/openworld/world/RouteRibbon.java"
TrafficSignals="*res://src/main/java/com/openworld/world/TrafficSignals.java"
TrainSystem="*res://src/main/java/com/openworld/world/TrainSystem.java"
ViewDistance="*res://src/main/java/com/openworld/world/ViewDistance.java"
QualitySettings="*res://src/main/java/com/openworld/game/QualitySettings.java"
FrontEnd="*res://src/main/java/com/openworld/game/FrontEnd.java"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=0.8

[editor_plugins]

enabled=PackedStringArray("res://addons/road_kit/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://src/main/resources/com/openworld/ui/game_theme.tres"

