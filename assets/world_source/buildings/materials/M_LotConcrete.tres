[gd_resource type="StandardMaterial3D" format=3]
; PRIVATE pavement (民地): every building's lot slab (`island_buildings.LOT_MATERIAL`) and the block ground between
; the lots (Terrain3D's "Urban" layer, packed from THIS file by `tools/make_urban_texture.py --from-lot`, which also
; prints the tint and tile the layer must carry in `assets/terrain3d/terrain_assets.tres`). Its PUBLIC twin is the
; footway, `assets/world_source/kits/road_kit/materials/M_ConcreteTile.tres`. Both ship with the same values (one
; look, kerb to door) until 2026-09-25, when this one was lifted ~8% (user: "slightly lighter" -- fresh
; brushed 土間コンクリート beside a weathered public footway); change THIS file to give private ground its own look, then:
;   python3 tools/island_buildings.py write      (the cell scenes reference this path; no re-derive)
;   python3 tools/make_urban_texture.py --from-lot   and copy the printed tint/uv onto the Urban texture asset
; Lives here, not in road_kit/materials: that folder is the road bake's material library and is hashed into every
; road piece's digest, so a lot edit there would rebuild every road.

[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_BaseColor.png" id="1_base"]
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_ORM.png" id="2_orm"]
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_Normal.png" id="3_nrm"]

[resource]
resource_name = "M_LotConcrete"
cull_mode = 2
albedo_color = Color(1, 0.98, 0.94, 1)
albedo_texture = ExtResource("1_base")
metallic = 1.0
metallic_texture = ExtResource("2_orm")
metallic_texture_channel = 2
roughness_texture = ExtResource("2_orm")
roughness_texture_channel = 1
normal_enabled = true
normal_texture = ExtResource("3_nrm")
ao_enabled = true
ao_texture = ExtResource("2_orm")
uv1_scale = Vector3(0.3663, 0.3663, 0.3663)
uv1_triplanar = true
uv1_world_triplanar = true
texture_filter = 5
