[gd_resource type="StandardMaterial3D" format=3]

; The white square tile a Japanese shop, lobby and forecourt floor is laid in (PLAN.md 3.18i, user: "the floor
; in Japanese buildings and stores is mostly white square tile, not plain concrete"). It is the footway's own
; material (`M_ConcreteTile`: the kit's concrete, world-space triplanar at the kit's 2.73 m module, so a scaled
; slab is not a stretched texture) tinted to a near-white porcelain and made smoother, so a building's lot and
; the pavement it meets are the SAME surface family and only the tone changes.
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_BaseColor.png" id="1_base"]
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_ORM.png" id="2_orm"]
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_Normal.png" id="3_nrm"]

[resource]
resource_name = "M_TileWhite"
cull_mode = 2
