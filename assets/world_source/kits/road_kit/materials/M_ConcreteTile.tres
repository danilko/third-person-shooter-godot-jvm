[gd_resource type="StandardMaterial3D" format=3]
; PUBLIC pavement: the FOOTWAY (歩道, the road's land). The road kit's default footway material
; (`point_kit.DEFAULT_MATERIAL["footway"]`), resolved by name at bake, so an edit here restyles every road piece
; with no rebuild. Its PRIVATE twin is `assets/world_source/buildings/materials/M_LotConcrete.tres` (the building
; plates and the block fill between them). The two share textures and tile; the private one is ~8% lighter (user,
; 2026-09-25), otherwise one look, kerb to
; door -- plain grey cast concrete, 土間コンクリート, world-space triplanar at the kit's 2.73 m module) and are two
; files so an artist can move either without the other. In Japan a public footway is as often asphalt, interlocking
; block or a permeable coloured paving as concrete, and a private forecourt is usually brushed 土間コンクリート
; (light when new, darkening with weather), so there is no fixed "private is darker" rule to encode here.

[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_BaseColor.png" id="1_base"]
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_ORM.png" id="2_orm"]
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_Normal.png" id="3_nrm"]

[resource]
resource_name = "M_ConcreteTile"
cull_mode = 2
albedo_color = Color(0.92, 0.9, 0.86, 1)
albedo_texture = ExtResource("1_base")
metallic = 1.0
metallic_texture = ExtResource("2_orm")
metallic_texture_channel = 2
roughness_texture = ExtResource("2_orm")
roughness_texture_channel = 1
normal_enabled = true
normal_texture = ExtResource("3_nrm")
ao_enabled = true
ao_texture = ExtResource("2_orm")
uv1_scale = Vector3(0.3663, 0.3663, 0.3663)
uv1_triplanar = true
uv1_world_triplanar = true
texture_filter = 5
