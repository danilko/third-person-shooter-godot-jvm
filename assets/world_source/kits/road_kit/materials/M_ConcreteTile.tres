[gd_resource type="StandardMaterial3D" format=3]
; PUBLIC pavement: the FOOTWAY (歩道, the road's land) -- and the raised median's fill -- the road kit's default footway
; material (`point_kit.DEFAULT_MATERIAL["footway"]`), resolved by name at bake, so an edit here restyles every road
; piece with no rebuild. ASPHALT since 2026-10-05 (user: "the sidewalk, the block's ground, the parking lots and the
; building plates all asphalt so they blend; kerbs and gutters stay concrete"; then "the same tone as the road"):
; the carriageway's own texture, tile AND tone (`M_Asphalt`) -- the concrete kerb and L-gutter mark the road's edge. The name is kept so no glTF or record changes; it is
; the footway slot's material, whatever it looks like. Its PRIVATE twin (the block's ground and the building plates)
; is `assets/world_source/buildings/materials/M_LotConcrete.tres`, asphalt too, between the two in tone.

; albedo_color 0.9 (2026-10-05, user: the block ground read a different tone from the sidewalk): measured top-down at
; noon, the Terrain3D Urban layer read sRGB 85.6 and these meshes 96.5 from the same texture; x0.9 brings road and
; footway to 85 (the meshes keep a faint blue sky reflection). Re-measure with tools/godot/shot_city.gd if changed.
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_Asphalt_BaseColor.png" id="1_base"]
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_ORM.png" id="2_orm"]
[ext_resource type="Texture2D" path="res://assets/world_source/kits/quaternius_downtown_city/textures/T_Concrete_Normal.png" id="3_nrm"]

[resource]
resource_name = "M_ConcreteTile"
cull_mode = 2
albedo_color = Color(0.9, 0.9, 0.9, 1)
albedo_texture = ExtResource("1_base")
metallic = 1.0
metallic_texture = ExtResource("2_orm")
metallic_texture_channel = 2
roughness_texture = ExtResource("2_orm")
roughness_texture_channel = 1
normal_enabled = true
normal_texture = ExtResource("3_nrm")
ao_enabled = true
ao_texture = ExtResource("2_orm")
uv1_scale = Vector3(0.3663, 0.3663, 0.3663)
uv1_triplanar = true
uv1_world_triplanar = true
texture_filter = 5
