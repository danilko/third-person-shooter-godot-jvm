[gd_resource type="StyleBoxFlat" format=3]

; The ONE background every HUD panel draws (health, weapon, speedometer, inventory column, feed rows):
; the minimap's translucent black (MinimapController.backgroundColor), so the whole HUD reads as one set.
[resource]
content_margin_left = 8.0
content_margin_top = 4.0
content_margin_right = 8.0
content_margin_bottom = 4.0
bg_color = Color(0, 0, 0, 0.45)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
