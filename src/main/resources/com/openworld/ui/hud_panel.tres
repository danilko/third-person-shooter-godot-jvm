[gd_resource type="StyleBoxFlat" format=3]

; The ONE background every HUD panel draws (health, weapon, speedometer, inventory column, feed rows, clock).
; SQUARE (no corner radius, user 2026-10-05: a flat look). Text-only (alpha 0) was tried the same day and measured on
; a bright ground: the white weapon silhouettes and the inventory list disappeared, so the boxes stay -- what looked
; "disorganised" was their EDGES, which sat 12-20 px from the screen edge. Every widget now puts its VISIBLE edge
; on one 20 px margin (probe_hud_layout "the visible edges share one margin"). A menu has menu_panel.tres.
[resource]
content_margin_left = 8.0
content_margin_top = 4.0
content_margin_right = 8.0
content_margin_bottom = 4.0
bg_color = Color(0, 0, 0, 0.45)
