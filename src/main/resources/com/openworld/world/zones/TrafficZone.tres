[gd_resource type="Resource" format=3]

; Streaming ambient-traffic zone (PLAN.md I3b) — walk within load_radius and WorldZoneManager spawns
; `count` AI cars on the "TrafficLane" route; they drive to its DESPAWN end, get freed by
; cullFinishedVehicles, and maintainTraffic tops the count back up. Used by TrafficZoneDemo.tscn.

[ext_resource type="Script" uid="uid://cbbpelnr1c44f" path="res://src/main/java/com/openworld/world/WorldZone.java" id="1_wz"]
[ext_resource type="Script" uid="uid://b1bktoqr6gxfn" path="res://gdj/com/openworld/world/VehicleSpawnConfig.gdj" id="2_veh"]

[sub_resource type="Resource" id="Resource_veh"]
script = ExtResource("2_veh")
faction = "neutral"
count = 3
cruise_throttle = 0.4
route_name = "TrafficLane"
metadata/_custom_type_script = "uid://b1bktoqr6gxfn"

[resource]
script = ExtResource("1_wz")
zone_id = "traffic_demo"
size = Vector3(60, 8, 30)
load_radius = 80.0
unload_radius = 150.0
vehicle_spawn_configs = Array[ExtResource("2_veh")]([SubResource("Resource_veh")])
