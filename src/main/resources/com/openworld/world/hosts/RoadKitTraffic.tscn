[gd_scene format=3]

; Road-system evaluation host (PLAN.md 3.1, 2026-09-13): the road kit's sample network built
; by `blender/tools/build_roads_piece.sh .../RoadKitSample.roads.json RoadKitSample`, with one zone
; streaming ambient traffic onto its lanes (route prefix "demo_"). Driven by
; tools/godot/probe_road_traffic.gd, which runs the same measurement on DebugWorld (road-generator then; a Road Kit network since 2026-09-13).

[ext_resource type="PackedScene" path="res://src/main/resources/com/openworld/world/pieces/RoadKitSample.tscn" id="piece"]
[ext_resource type="PackedScene" path="res://src/main/resources/com/openworld/character/Player.tscn" id="player"]
[ext_resource type="PackedScene" path="res://src/main/resources/com/openworld/world/WorldSystems.tscn" id="wsys"]
[ext_resource type="Script" path="res://src/main/java/com/openworld/world/ZoneMarker.java" id="zmark"]
[ext_resource type="Script" path="res://src/main/java/com/openworld/world/Zone.java" id="zone"]
[ext_resource type="Script" path="res://src/main/java/com/openworld/world/VehicleSpawnConfig.java" id="vspawn"]

[sub_resource type="BoxShape3D" id="ground_shape"]
size = Vector3(4000, 1, 2000)

[sub_resource type="Resource" id="traffic"]
script = ExtResource("vspawn")
count = 6
cruise_throttle = 0.4
route_name = "demo_"

[sub_resource type="Resource" id="zone_x"]
script = ExtResource("zone")
zone_id = "roadkit_cross"
size = Vector3(80, 12, 80)
vehicle_spawn_configs = Array[ExtResource("vspawn")]([SubResource("traffic")])

